      "reduction": "mean",
      "denominator": "N_reason_eligible",
      "class_weight": null,
      "zero_eligible_batch": "_p2_differentiable_zero(output['reason_logits_4'])"
    },
    "local_losses": {
      "frame_bce": {
        "reduction": "mean",
        "eligibility": "reason_supervision_eligible",
        "gradient_owner": "FrameGate"
      },
      "predicate_bce": {
        "reduction": "mean",
        "eligibility": "reason_supervision_eligible && frame_compatible_label == 1",
        "gradient_owner": "PredicateCoverageHead"
      },
      "sufficiency_bce": {
        "reduction": "mean",
        "eligibility": "reason_supervision_eligible && frame_compatible_label == 1 && predicate_covered_label == 1",
        "gradient_owner": "SufficiencyGate"
      },
      "polarity_ce": {
        "reduction": "mean",
        "eligibility": "reason_supervision_eligible && frame_compatible_label == 1 && predicate_covered_label == 1 && sufficiency_label == 1 && final_label in {REFUTE,SUPPORT}",
        "gradient_owner": "PolarityEnergyHead",
        "class_order": ["REFUTE", "SUPPORT"]
      }
    },
