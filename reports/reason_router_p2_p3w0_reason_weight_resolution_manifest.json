      "shape": "[N_selected, 3]",
      "class_count": 3,
      "class_order": ["REFUTE", "NOT_ENTITLED", "SUPPORT"],
      "reduction": "mean",
      "denominator": "N_selected",
      "class_weight": "weights if weighted_label_loss else None"
