        "        \"    conv_state = other_cache.update_conv_state(self.layer_idx, hidden_states)\",",
        "    )",
        "    assert_convolution_blocks(tmp_path, noncache, \"BLOCKED_REQUIRED_SYMBOL_UNRESOLVED\")",
        "    nested = convolution_mamba(",
