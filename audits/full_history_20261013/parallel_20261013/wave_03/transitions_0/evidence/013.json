        "        for wrong_arm, wrong_map in G3_GROUPED_EXPECTED_MAPS.items():",
        "            if wrong_arm != arm:",
        "                with pytest.raises(ValueError, match=\"G3_ARM_EDGE_MAP_MISMATCH\"):",
