        "def test_p2_canonical_lineage_rejects_sidecar_identity_corruption() -> None:",
        "    records, sidecar = _p2_lineage_records(\"pair_x\", \"train\")",
        "    sidecar[\"pair_x__entity_swap\"][\"row_id\"] = \"wrong\"",
