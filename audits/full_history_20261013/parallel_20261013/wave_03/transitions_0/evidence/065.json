        "            \"runtime-sha\",",
        "    }",
        "",
        "    manifest = _synthetic_manifest(",
        "        head,",
        "        code_sha,",
        "    )",
        "    preflight = (",
        "        _synthetic_preflight_value()",
        "    )",
        "",
        "    files = {",
        "        validator.MANIFEST_FILE:",
        "            _canonical_json_bytes(",
