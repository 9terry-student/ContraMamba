        "    if value not in (None, \"\"):",
        "        return str(value)",
        "    return infer_expected_route(group)",
        "",
        "",
        "def metadata_status(rows: list[dict[str, Any]]) -> dict[str, Any]:",
        "    groups = [resolve_group(row) for row in rows]",
